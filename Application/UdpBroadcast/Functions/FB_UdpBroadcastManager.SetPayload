METHOD SetPayload : BOOL
VAR_INPUT
    ChannelIndex : UINT;
    pData : POINTER TO BYTE;
    SizeBytes : UDINT;
END_VAR

SetPayload := FALSE;

IF ChannelIndex > CHANNEL_LAST THEN
    RETURN;
END_IF

payload_ptr[ChannelIndex] := pData;
payload_size_bytes[ChannelIndex] := SizeBytes;

SetPayload := (pData <> 0) AND (SizeBytes > UDINT#0);
