{attribute 'pack_mode' := '1'}
(*
  Общие настройки UDP в Holding Registers (Modbus).
  4 IP-адреса приемников хранятся как WORD-октеты.
  0.0.0.0 выключает соответствующий слот.
*)
TYPE ST_UdpBroadcastCommonModbus :
STRUCT
    target1_ip : ST_UdpIPv4Modbus := (octet_0 := 192, octet_1 := 168, octet_2 := 4, octet_3 := 255);
    target2_ip : ST_UdpIPv4Modbus;
    target3_ip : ST_UdpIPv4Modbus;
    target4_ip : ST_UdpIPv4Modbus;

    (* Статус IP-слота: 0 = используется, 1 = не используется, 2 = ошибка IP, 3 = дубликат IP. *)
    target1_status : WORD := 0;
    target2_status : WORD := 1;
    target3_status : WORD := 1;
    target4_status : WORD := 1;
END_STRUCT
END_TYPE
