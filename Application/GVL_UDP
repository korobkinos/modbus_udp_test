(*
  Глобальные данные UDP-рассылки.
  udp_settings можно перенести в RETAIN в прикладном проекте.
*)
VAR_GLOBAL
    udp_settings : ST_UdpBroadcastSettings;

    (* Общая Modbus-карта UDP. Адреса сохранены: %MW160..%MW179. *)
    udp_common_modbus AT %MW160 : ST_UdpBroadcastCommonModbus;

    (* Modbus-карта каналов. Стартовый адрес сохранен: %MW0. *)
    udp_channel_modbus AT %MW0 : ARRAY[0..9] OF ST_UdpBroadcastChannelModbus;
END_VAR
