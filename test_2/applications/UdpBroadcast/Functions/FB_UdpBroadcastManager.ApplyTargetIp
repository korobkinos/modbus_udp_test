METHOD PRIVATE ApplyTargetIp : BOOL
(*
  Переносит IP-адреса получателей из Modbus-карты в строки broadcast_ip.
  Для каждого слота записывает статус проверки в target_status.
*)
VAR_IN_OUT
    CommonMapRef : ST_UdpBroadcastCommonModbus;
END_VAR

// === IMPLEMENTATION ===

FOR ip_slot := IP_SLOT_FIRST TO IP_SLOT_LAST DO
    CommonMapRef.target_status[ip_slot] := ApplyIPv4FromWords(
        Ip := CommonMapRef.target_ip[ip_slot],
        SlotIndex := ip_slot,
        IpAddress := broadcast_ip[ip_slot]
    );
END_FOR

ApplyTargetIp := TRUE;
