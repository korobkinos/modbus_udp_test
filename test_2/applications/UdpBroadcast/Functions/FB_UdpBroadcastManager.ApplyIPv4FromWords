METHOD PRIVATE ApplyIPv4FromWords : WORD
(*
  Проверяет IPv4 из четырех WORD-октетов и собирает строку адреса.
  Возвращает статус слота: 0 = используется, 1 = не используется,
  2 = ошибка IP, 3 = дубликат IP.
*)
VAR_INPUT
    Ip : ST_UdpIPv4Modbus;
    SlotIndex : UINT;
END_VAR
VAR_IN_OUT
    IpAddress : STRING(16);
END_VAR
VAR
    sIp : STRING(16);
    i : UINT;
END_VAR

// === IMPLEMENTATION ===

ApplyIPv4FromWords := 2;

IF (Ip.octet_0 > 255) OR
   (Ip.octet_1 > 255) OR
   (Ip.octet_2 > 255) OR
   (Ip.octet_3 > 255) THEN
    IpAddress := '';
    RETURN;
END_IF

IF (Ip.octet_0 = 0) AND (Ip.octet_1 = 0) AND (Ip.octet_2 = 0) AND (Ip.octet_3 = 0) THEN
    IpAddress := '';
    ApplyIPv4FromWords := 1;
    RETURN;
END_IF

sIp := CONCAT(BYTE_TO_STRING(WORD_TO_BYTE(Ip.octet_0)), '.');
sIp := CONCAT(sIp, BYTE_TO_STRING(WORD_TO_BYTE(Ip.octet_1)));
sIp := CONCAT(sIp, '.');
sIp := CONCAT(sIp, BYTE_TO_STRING(WORD_TO_BYTE(Ip.octet_2)));
sIp := CONCAT(sIp, '.');
sIp := CONCAT(sIp, BYTE_TO_STRING(WORD_TO_BYTE(Ip.octet_3)));

IF SlotIndex > UINT#1 THEN
    FOR i := UINT#1 TO SlotIndex - UINT#1 DO
        IF (broadcast_ip[i] <> '') AND (sIp = broadcast_ip[i]) THEN
            IpAddress := '';
            ApplyIPv4FromWords := 3;
            RETURN;
        END_IF
    END_FOR
END_IF

IpAddress := sIp;
ApplyIPv4FromWords := 0;
