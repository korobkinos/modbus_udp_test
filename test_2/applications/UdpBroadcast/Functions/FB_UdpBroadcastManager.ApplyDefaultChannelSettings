METHOD PRIVATE ApplyDefaultChannelSettings : BOOL
(* Жесткие настройки UDP-каналов. Вызывается каждый цикл, поэтому online-изменения channel_cfg перезаписываются. *)
VAR_IN_OUT
    SettingsRef : ST_UdpBroadcastSettings;
END_VAR

// === IMPLEMENTATION ===

SettingsRef.enable_all := TRUE;

(* Общие параметры для всех каналов. start_send здесь не трогаем: его обрабатывает RunChannels. *)
FOR ch := CHANNEL_FIRST TO CHANNEL_LAST DO
    SettingsRef.channel_cfg[ch].packet_type := 1;
    SettingsRef.channel_cfg[ch].version := 1;
    SettingsRef.channel_cfg[ch].max_packet_bytes_limit := 1472;
    SettingsRef.channel_cfg[ch].payload_endianness := 0;
    SettingsRef.channel_cfg[ch].inter_packet_delay_ms := 0;
END_FOR

(* Канал 0: состояние арматуры. *)
SettingsRef.channel_cfg[0].enable := 1;
SettingsRef.channel_cfg[0].signature := 16#30304D41;
SettingsRef.channel_cfg[0].local_port := 15010;
SettingsRef.channel_cfg[0].remote_port := 15000;
SettingsRef.channel_cfg[0].period_ms := 200;

(* Канал 1: аналоговые данные арматуры. *)
SettingsRef.channel_cfg[1].enable := 1;
SettingsRef.channel_cfg[1].signature := 16#31304D41;
SettingsRef.channel_cfg[1].local_port := 15011;
SettingsRef.channel_cfg[1].remote_port := 15001;
SettingsRef.channel_cfg[1].period_ms := 200;

(* Канал 2: состояние защит. *)
SettingsRef.channel_cfg[2].enable := 1;
SettingsRef.channel_cfg[2].signature := 16#32304D41;
SettingsRef.channel_cfg[2].local_port := 15012;
SettingsRef.channel_cfg[2].remote_port := 15002;
SettingsRef.channel_cfg[2].period_ms := 500;

(* Канал 3: тренды регуляторов. *)
SettingsRef.channel_cfg[3].enable := 1;
SettingsRef.channel_cfg[3].signature := 16#33304D41;
SettingsRef.channel_cfg[3].local_port := 15013;
SettingsRef.channel_cfg[3].remote_port := 15003;
SettingsRef.channel_cfg[3].period_ms := 500;

(* Канал 4: настройки PID. *)
SettingsRef.channel_cfg[4].enable := 1;
SettingsRef.channel_cfg[4].signature := 16#34304D41;
SettingsRef.channel_cfg[4].local_port := 15014;
SettingsRef.channel_cfg[4].remote_port := 15004;
SettingsRef.channel_cfg[4].period_ms := 2000;

(* Канал 5: значения AI после обработки. *)
SettingsRef.channel_cfg[5].enable := 1;
SettingsRef.channel_cfg[5].signature := 16#35304D41;
SettingsRef.channel_cfg[5].local_port := 15015;
SettingsRef.channel_cfg[5].remote_port := 15005;
SettingsRef.channel_cfg[5].period_ms := 200;

(* Канал 6: состояния AI. *)
SettingsRef.channel_cfg[6].enable := 1;
SettingsRef.channel_cfg[6].signature := 16#36304D41;
SettingsRef.channel_cfg[6].local_port := 15016;
SettingsRef.channel_cfg[6].remote_port := 15006;
SettingsRef.channel_cfg[6].period_ms := 1000;

(* Канал 7: настройки AI. *)
SettingsRef.channel_cfg[7].enable := 1;
SettingsRef.channel_cfg[7].signature := 16#37304D41;
SettingsRef.channel_cfg[7].local_port := 15017;
SettingsRef.channel_cfg[7].remote_port := 15007;
SettingsRef.channel_cfg[7].period_ms := 2000;

(* Канал 8: состояние DI/DO. *)
SettingsRef.channel_cfg[8].enable := 1;
SettingsRef.channel_cfg[8].signature := 16#38304D41;
SettingsRef.channel_cfg[8].local_port := 15018;
SettingsRef.channel_cfg[8].remote_port := 15008;
SettingsRef.channel_cfg[8].period_ms := 500;

(* Канал 9: резерв, по умолчанию выключен. *)
SettingsRef.channel_cfg[9].enable := 0;
SettingsRef.channel_cfg[9].signature := 16#39314D41;
SettingsRef.channel_cfg[9].local_port := 15019;
SettingsRef.channel_cfg[9].remote_port := 15009;
SettingsRef.channel_cfg[9].period_ms := 2000;
ApplyDefaultChannelSettings := TRUE;
