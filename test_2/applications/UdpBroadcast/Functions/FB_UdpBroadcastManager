{attribute 'no_assign'}
FUNCTION_BLOCK FB_UdpBroadcastManager
(*
  Управляет несколькими UDP-каналами:
  - задает настройки каналов жесткими константами;
  - читает IP-адреса получателей из Modbus;
  - запускает FB_UdpWordBroadcast для каждого канала.
*)
VAR_IN_OUT
    Settings  : ST_UdpBroadcastSettings;     (* Рабочие настройки UDP-каналов. *)
    CommonMap : ST_UdpBroadcastCommonModbus; (* Modbus-карта IP-адресов и статусов. *)
END_VAR
VAR
    CHANNEL_FIRST : UINT := 0; (* Первый UDP-канал. *)
    CHANNEL_LAST  : UINT := 9; (* Последний UDP-канал. *)
    IP_SLOT_FIRST : UINT := 1; (* Первый слот IP-получателя. *)
    IP_SLOT_LAST  : UINT := 4; (* Последний слот IP-получателя. *)

    (* Рабочие экземпляры отправителя и состояние каналов. *)
    tx : ARRAY[0..9] OF FB_UdpWordBroadcast;
    runtime_state : ARRAY[0..9] OF ST_UdpBroadcastState;

    (* Внешний payload задается через SetPayload. *)
    payload_ptr : ARRAY[0..9] OF POINTER TO BYTE;
    payload_size_bytes : ARRAY[0..9] OF UDINT;

    (* Подготовленные IP-адреса назначения. *)
    broadcast_ip : ARRAY[1..4] OF STRING(16);

    local_ip_init_done : BOOL;       (* Локальный IP уже определен. *)
    detected_local_ip : STRING(16);  (* Найденный локальный IP. *)

    ch : UINT;                         (* Индекс UDP-канала. *)
    ip_slot : UINT;                    (* Индекс IP-слота. *)
    start_send_pulse : BOOL;           (* Одноцикловая команда ручной отправки. *)
    fb_enable : BOOL;                  (* Разрешение работы текущего канала. *)
    current_payload_ptr : POINTER TO BYTE; (* Указатель на payload текущего канала. *)
    current_payload_size_bytes : UDINT;    (* Размер payload текущего канала. *)
END_VAR

// === IMPLEMENTATION ===

(* Определяем локальный IP один раз при старте. *)
DetectLocalIp(SettingsRef := Settings);

(* Каждый цикл задаем жесткие настройки UDP-каналов. *)
ApplyDefaultChannelSettings(SettingsRef := Settings);

(* Читаем IP получателей из Modbus-карты и формируем статусы IP-слотов. *)
ApplyTargetIp(
    CommonMapRef := CommonMap
);

(* Запускаем отправку по всем UDP-каналам. *)
RunChannels(
    SettingsRef := Settings
);
