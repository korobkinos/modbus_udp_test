{attribute 'no_assign'}
FUNCTION_BLOCK FB_UdpBroadcastManager
(*
  Управляет несколькими UDP-каналами:
  - uses channel settings assigned by program constants;
  - reads target IP addresses from Modbus;
  - подставляет payload для каждого канала и запускает FB_UdpWordBroadcast.
*)
VAR_IN_OUT
    Settings  : ST_UdpBroadcastSettings;
    CommonMap : ST_UdpBroadcastCommonModbus;
END_VAR
VAR_OUTPUT
    Active : BOOL;
END_VAR
VAR
    CHANNEL_FIRST : UINT := 0;
    CHANNEL_LAST  : UINT := 9;
    IP_SLOT_FIRST : UINT := 1;
    IP_SLOT_LAST  : UINT := 4;

    (* Рабочие экземпляры отправителя и состояние каналов. *)
    tx : ARRAY[0..9] OF FB_UdpWordBroadcast;
    runtime_state : ARRAY[0..9] OF ST_UdpBroadcastState;

    (* Внешний payload задается через SetPayload. *)
    payload_ptr : ARRAY[0..9] OF POINTER TO BYTE;
    payload_size_bytes : ARRAY[0..9] OF UDINT;

    (* Подготовленные IP-адреса назначения. *)
    broadcast_ip : ARRAY[1..4] OF STRING(16);

    local_ip_init_done : BOOL;
    detected_local_ip : STRING(16);

    ch : UINT;
    ip_slot : UINT;
    start_send_pulse : BOOL;
    fb_enable : BOOL;
    current_payload_ptr : POINTER TO BYTE;
    current_payload_size_bytes : UDINT;
END_VAR

// === IMPLEMENTATION ===

DetectLocalIp(SettingsRef := Settings);

ApplyDefaultChannelSettings(SettingsRef := Settings);

ApplyTargetIp(
    CommonMapRef := CommonMap
);

RunChannels(
    SettingsRef := Settings
);

Active := TRUE;
