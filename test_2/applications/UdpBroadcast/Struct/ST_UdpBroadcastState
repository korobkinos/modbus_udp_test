(*
  Состояние одного канала UDP-рассылки.
  Каждый элемент массива state соответствует своему экземпляру FB.
*)
TYPE ST_UdpBroadcastState :
STRUCT
    busy         : BOOL;    (* Выполняется цикл передачи *)
    packet_count : WORD;    (* Кол-во отправок в цикле с учетом активных IP *)
    send_count   : UDINT;   (* Счетчик успешно отправленных пакетов *)
    error_code   : UINT;    (* Код источника ошибки FB: 0..10 *)
    last_cycle_time_ms : WORD; (* Время предыдущего успешного цикла отправки, мс *)
END_STRUCT
END_TYPE