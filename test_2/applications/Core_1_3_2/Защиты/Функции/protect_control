FUNCTION_BLOCK protect_control EXTENDS valve_control
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	protect_array		:	ARRAY [1..PROTECT_QUANTITY] OF protect_singl;
	//command_singl		:	CommandStructure;
	state_local			:	DWORD;
	binding_counter		:	WORD;
	binding_quantity	:	WORD;		//Количество привязанных битов (задействовано сенсоров защиты)
	binding_active		:	ARRAY [1..3] OF BOOL;
END_VAR

// === IMPLEMENTATION ===

_objects_quantity:= PROTECT_QUANTITY;
//_event_settings:= ADR(SETTINGS.DATA.PROTECT_EVENT_SETTINGS);

FOR counter:= 1 TO PROTECT_QUANTITY  DO
	protect_array[counter](delay_time:= ADR(SETTINGS.DATA.PROTECT_SETTINGS.Number[counter].Delay));
	_object_itf[counter]:= protect_array[counter];
	command_singl.Command:= MODBUS.PROTECT_COMMAND[counter](* OR MODBUS.PROTECT_OPCUA[counter].Command*);
	command_singl.SelectedNumber:= counter;
	IF command_singl.Command <> 0 THEN
		SetCommand(command_singl);
	END_IF
	MODBUS.PROTECT_STATE[counter]:= GetState(counter);
	MODBUS.PROTECT_STATE_OPCUA[counter].DwValue:= MODBUS.PROTECT_STATE[counter];
	
	//Устанавливаем 4, 5, 6 биты Sensor
	binding_quantity:= 0;
	FOR binding_counter:= 1 TO 3 DO
		IF MAIN.main_itf[SETTINGS.DATA.PROTECT_SETTINGS.Number[counter].Sensor[binding_counter].ItfNumber] <> NULL THEN
			IF SETTINGS.DATA.PROTECT_SETTINGS.Number[counter].Sensor[binding_counter].ObjectNumber > 0 AND SETTINGS.DATA.PROTECT_SETTINGS.Number[counter].Sensor[binding_counter].ObjectNumber <= MAIN.main_itf[SETTINGS.DATA.PROTECT_SETTINGS.Number[counter].Sensor[binding_counter].ItfNumber].GetObjectCount() THEN
				state_local:= MAIN.main_itf[SETTINGS.DATA.PROTECT_SETTINGS.Number[counter].Sensor[binding_counter].ItfNumber].GetState(SETTINGS.DATA.PROTECT_SETTINGS.Number[counter].Sensor[binding_counter].ObjectNumber);
				binding_active[binding_counter]:= GetBit(state_local, WORD_TO_BYTE(SETTINGS.DATA.PROTECT_SETTINGS.Number[counter].Sensor[binding_counter].BitNumber));
				SetState(counter, 3 + binding_counter,  binding_active[binding_counter] XOR WORD_TO_BOOL(SETTINGS.DATA.PROTECT_SETTINGS.Number[counter].Sensor[binding_counter].BitInverse));
				binding_quantity:= binding_quantity + 1;
			END_IF
		END_IF
	END_FOR
	//Если подключен 1 датчик, то любой из 3х вызывает защиту, иначе, через функцияю 2 из 3х
	//Если снять привязку, а там была 1, то она зависнет и всегда будет сработка до перезагрузки
	IF binding_quantity = 1 THEN
		SetState(counter, 7, binding_active[1] OR binding_active[2] OR binding_active[3]);
	ELSE
 		SetState(counter, 7, TwoFromTree(binding_active[1], binding_active[2], binding_active[3]));
	END_IF
END_FOR

//Получаем настройки выбранной Защиты
IF MODBUS.PROTECT_MANAGER_DATA.Command = 2 THEN
	MODBUS.PROTECT_MANAGER_DATA.Settings:= GetProtectSettings(MODBUS.PROTECT_MANAGER_DATA.SelectedNumber);
END_IF

//Запись настроек Защиты по команде
binding_tof(IN:= SaveProtectSettings(ADR(MODBUS.PROTECT_MANAGER_DATA)), PT:= T#1S);
binding_ton(IN:= binding_tof.Q, PT:= T#500MS);
IF binding_ton.Q THEN	//Команда сбрасывается при успешной записи
	SettingsSaveDone();
END_IF

//Чтение настроек защит из файла
IF MODBUS.PROTECT_MANAGER_DATA.Command = 4 THEN
//('/mnt/user/codesys/usb0/protect_settings.txt');
	MODBUS.PROTECT_MANAGER_DATA.Command:= ReadProtectFile('protect_settings.txt');//
END_IF

file_header:= CONCAT(FILE_HEADER_UNITE, 'ObjectNumber$09Delay$09ItfBinding1$09ObjectBinding1$09BitBinding1$09BitInverce1$09ItfBinding2$09ObjectBinding2$09BitBinding2$09BitInverce2$09ItfBinding3$09ObjectBinding3$09BitBinding3$09BitInverce3$0A');
//Сохраняем настройки защит в файл
IF MODBUS.PROTECT_MANAGER_DATA.Command = 5 THEN
	IF SaveProtectFile('protect_settings.txt', file_header) THEN
		MODBUS.PROTECT_MANAGER_DATA.Command:= 6;
	END_IF
END_IF