TYPE ArmatureStateBit :
STRUCT
    // Доступ через имена битов
	PhysClosed		: BIT;		// 0	ЗАКРЫТ (ВЫКЛЮЧЕН)
    PhysOpen		: BIT;		// 1	ОТКРЫТ (ВКЛЮЧЕН)
	PhysMoving		: BIT;		// 2	Двигатель включен (ХОД)
	Stop			: BIT;		// 3	СТОП
	MoveUp			: BIT;		// 4	Ход на открытие (Больше) ВКЛЮЧИТЬ (ОТКРЫТЬ)
	MoveDown		: BIT;		// 5	Ход на закрытие (Меньше) ОТКЛЮЧИТЬ(ЗАКРЫТЬ)
	ControlOn		: BIT;		// 6	Управляющий выход включен
	PhysSpecial		: BIT;		// 7	Спец.позиция
	AutoMode		: BIT;		// 8	Автоматический режим
	Error			: BIT;		// 9	Авария
	Blocked			: BIT;		// 10	Заблокирован
	Imitation		: BIT;		// 11	Режим имитации
	TestMode		: BIT;		// 12	Режим теста арматуры
	ManualMode		: BIT;		// 13	Ручное(на арматуре)
	LockalMode		: BIT;		// 14	Местное(На шкафе)
	DistanceMode	: BIT;		// 15	Дистанция (ПТК)
	MomentError		: BIT;		// 16	Авария по моменту
	Bit17			: BIT;		// 17	ОТКЛ техн.ЗАЩ
	Bit18			: BIT;		// 18	КВЭ раб.полож
	Bit19			: BIT;		// 19	КВЭ контр..полож
	Bit20			: BIT;		// 20	ЗН замкнут
	Bit21			: BIT;		// 21	ЗН разомкнут
	Bit22			: BIT;		// 22	Срабат РЗА (обобщ)
	Bit23			: BIT;		// 23	Положение ключа "М"
	Bit24			: BIT;		// 24	Положение ключа "ДУ"
	Bit25			: BIT;		// 25	Неиспр. МП РЗА
	Bit26			: BIT;		// 26	Автомат цепей упр. ВЫКЛ
	Bit27			: BIT;		// 27	Отключение от оптической ДЗ
	Bit28			: BIT;		// 28	Дверь отсека КВЭ закрыта
	Bit29			: BIT;		// 29	Дверь отсека присоединений ЗАКР
	Bit30			: BIT;		// 30	Дверь отсека ВЦ ЗАКР
	Bit31			: BIT;		// 31	ОЗЗ
END_STRUCT
END_TYPE