FUNCTION_BLOCK do_control EXTENDS di_control
VAR_INPUT
	do_local				:	ARRAY[1..DO_QUANTITY] OF BOOL;
END_VAR
VAR

END_VAR

// === IMPLEMENTATION ===

_objects_quantity:= DO_QUANTITY;
_digital_binding:= ADR(SETTINGS.DATA.DO_DIGITAL_BINDING);
_digitai_local:= ADR(do_local);


FOR counter:= 1 TO DO_QUANTITY  DO
	di_object[counter]();
	_object_itf[counter]:= di_object[counter];
	state_temp.0:= do_local[counter];
	di_object[counter].State:= state_temp;
	//Привязка входа к биту объекта
	IF GetBinding(ObjectNumber:= counter, settings=> digital_binding) AND MAIN.main_itf[digital_binding.ItfNumber] <> NULL THEN
		do_local[counter]:= GetBit(MAIN.main_itf[digital_binding.ItfNumber].GetState(digital_binding.ObjectNumber), WORD_TO_BYTE(digital_binding.BitNumber));
	ELSE
		do_local[counter]:= 0;	//Зануляем выход, если он ни к чему не привязан
	END_IF
END_FOR

//Устанавливаем физические выходы
MODBUS.DO_MAIN:= do_to_modul(do_local:= do_local);

//Проверяем повторную привязку
MODBUS.DO_MANAGER_DATA.DuplicateNumber:= GetBusy(MODBUS.DO_MANAGER_DATA.BindingData) OR Service();

//Получаем настройки выбранного DO
IF MODBUS.DO_MANAGER_DATA.Command = 2 THEN
	GetBinding(ObjectNumber:= MODBUS.DO_MANAGER_DATA.SelectedNumber, Settings=> MODBUS.DO_MANAGER_DATA.BindingData);
	//MODBUS.DO_MANAGER_DATA.BindingData:= GetBinding(MODBUS.DO_MANAGER_DATA.SelectedNumber);
END_IF

//Запись настроек по команде
binding_tof(IN:= SaveBinding(ADR(MODBUS.DO_MANAGER_DATA)), PT:= T#1S);
binding_ton(IN:= binding_tof.Q, PT:= T#500MS);
IF binding_ton.Q THEN	//Команда сбрасывается при успешной записи
	MODBUS.DO_MANAGER_DATA.Command:= 2;	
	MODBUS.DO_MANAGER_DATA.BindingData.ItfNumber:= 0;
	MODBUS.DO_MANAGER_DATA.BindingData.ObjectNumber:= 0;
	MODBUS.DO_MANAGER_DATA.BindingData.BitNumber:= 0;
END_IF

//Чтение настроек из файла
IF MODBUS.DO_MANAGER_DATA.Command = 4 THEN
	MODBUS.DO_MANAGER_DATA.Command:= ReadBindingFile('do_binding.txt');//('/mnt/user/codesys/usb0/di_binding.txt');
END_IF

file_header:= CONCAT(FILE_HEADER_UNITE, 'ObjectNumber$09ItfBinding$09ObjectBinding$09BitBinding$0A');
//Сохранение настроек в файл
IF MODBUS.DO_MANAGER_DATA.Command = 5 THEN
	IF SaveBindingFile('do_binding.txt', file_header)THEN//('/mnt/user/codesys/usb0/di_binding.txt');
		MODBUS.DO_MANAGER_DATA.Command:= 6;//Успех
	END_IF
END_IF