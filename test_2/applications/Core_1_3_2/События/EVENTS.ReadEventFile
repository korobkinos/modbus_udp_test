METHOD PRIVATE ReadEventFile : WORD
VAR_INPUT
	FilePath			:	STRING; (* Путь к файлу, например 'di_binding.txt' , '/mnt/user/codesys/usb0/di_binding.txt'*)
END_VAR

VAR
	settings_data		:	EventManagerData;
	hFile 				:	POINTER TO SysFile.RTS_IEC_HANDLE;//RTS_IEC_HANDLE;
	Col					:	STRING(255);
	file_open_error		:	UDINT;
	ByteData			:	BYTE;
	EventCounter		:	WORD;
	case_counter		:	WORD;
	ByteRead				:	DWORD;
	FileStartTime			:	ULINT;
	FileStopTime			:	ULINT;
	
END_VAR
VAR CONSTANT
	ReadCompleted			:	WORD:= 6;	//Чтение строки завершено успешно
	FileError				:	WORD:= 7;	//Ошибка файла
	ReadTimeOut				:	WORD:= 8;	//Прервано по таймауту
	
END_VAR

// === IMPLEMENTATION ===

//Открываем файл для чтения
hFile := SysFile.SysFileOpen(FilePath, SysFile.AM_READ, file_open_error);
IF hFile = 0 OR hFile = 16#FFFFFFFF THEN
    // Не удалось открыть файл
	ReadEventFile:= FileError;
    RETURN;
END_IF
//Получим текущее время ПЛК
SysTimeRtcHighResGet(FileStartTime);

//line_counter:= 1;
FOR EventCounter:= 1 TO EVENT_QUANTITY + 2 DO
	case_counter:= 0;
	// Читаем байты до конца строки или конца файла
	WHILE TRUE DO
		ByteRead:= SysFile.SysFileRead(hFile, ADR(ByteData), 1, file_open_error);
		// Проверка конца файла
		IF file_open_error <> 0 THEN
			ReadEventFile:= FileError;
			EXIT;  // Выходим при ошибке чтения (конец файла)
		END_IF;
		// Если не табуляция (9) и не конец строки - добавляем к текущей строке
		IF ByteData <> 9 AND ByteData <> 10 THEN
			Col:= CONCAT(Col, WORD_AS_STRING(ByteData, 0));
		END_IF;
		//Удаляем табуляцию в первых 2х строках
		IF ByteData = 9 AND EventCounter <= 2 THEN
			ByteData:= 0;
		END_IF
		//Если 3я и последующие строки, то формируем digital_manager_data
		IF (ByteData = 9 OR ByteData = 10) AND EventCounter > 2 THEN
			case_counter:= case_counter + 1;
			CASE case_counter OF
				1: settings_data.SelectedNumber:= STRING_TO_WORD(Col);
				2: settings_data.Settings.Value[1]:= STRING_TO_WORD(Col);
				3: settings_data.Settings.Value[2]:= STRING_TO_WORD(Col);
				4: settings_data.Settings.Value[3]:= STRING_TO_WORD(Col);
				5: settings_data.Settings.Value[4]:= STRING_TO_WORD(Col);
				6: settings_data.Settings.Value[5]:= STRING_TO_WORD(Col);
				7: settings_data.Settings.Value[6]:= STRING_TO_WORD(Col);
				8: settings_data.Settings.Value[7]:= STRING_TO_WORD(Col);
				9: settings_data.Settings.Value[8]:= STRING_TO_WORD(Col);
				10: settings_data.Settings.Value[9]:= STRING_TO_WORD(Col);
				11: settings_data.Settings.Value[10]:= STRING_TO_WORD(Col);
				12: settings_data.Settings.Value[11]:= STRING_TO_WORD(Col);
			END_CASE
		END_IF
		//Обнуляем Col при получении TAB
		IF ByteData = 9 OR ByteData = 10 THEN
			Col:='';
		END_IF
		//Записываем в RETAIN	
		IF (ByteData = 10 AND EventCounter > 2) OR ByteRead = 0  THEN
			settings_data.Command:= 1;
			SaveEvents(ADR(settings_data));
		END_IF
		SysTimeRtcHighResGet(FileStopTime);
		IF FileStopTime - FileStartTime >= 100 THEN
			ReadEventFile:= ReadTimeOut;
		END_IF
		// Если встретили конец строки (10)
		IF ByteData = 10 OR ByteRead = 0 THEN
			settings_data.Command:= 0;
			settings_data.SelectedNumber:= 0;
			settings_data.Settings.Value[1]:= 0;
			settings_data.Settings.Value[2]:= 0;
			settings_data.Settings.Value[3]:= 0;
			settings_data.Settings.Value[4]:= 0;
			settings_data.Settings.Value[5]:= 0;
			settings_data.Settings.Value[6]:= 0;
			settings_data.Settings.Value[7]:= 0;
			settings_data.Settings.Value[8]:= 0;
			settings_data.Settings.Value[9]:= 0;
			settings_data.Settings.Value[10]:= 0;
			settings_data.Settings.Value[11]:= 0;
			EXIT;  // Выходим из внутреннего цикла, переходим к следующей строке
		END_IF
		//Если таймаут
		IF ReadEventFile = ReadTimeOut THEN
			EXIT;
		END_IF
	END_WHILE
	//Выход из внешнего цикла
	IF ReadEventFile = ReadTimeOut OR ReadEventFile = FileError OR ByteRead = 0 THEN
		EXIT;
	END_IF
END_FOR

//Закрываем файл
SysFile.SysFileClose(hFile);

// Успешное завершение
IF ReadEventFile = 0 THEN
	ReadEventFile:= ReadCompleted;
END_IF
RETURN;